{
  "name": "multilingual-wordle",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=public/script.js",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/main.ts --bundle --outfile=public/script.js --watch",
    "test": "npm run typecheck && node test/hangul.mjs && node test/stats-share.mjs && node test/guess-tiles.mjs",
    "test:layout": "node test/header-layout.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
